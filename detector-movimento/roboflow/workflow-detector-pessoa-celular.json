{
  "version": "1.0",
  "inputs": [
    {
      "type": "WorkflowImage",
      "name": "image"
    },
    {
      "type": "WorkflowParameter",
      "name": "confidence",
      "default_value": 0.15
    }
  ],
  "steps": [
    {
      "type": "roboflow_core/roboflow_object_detection_model@v2",
      "name": "detector",
      "image": "$inputs.image",
      "model_id": "rfdetr-medium",
      "confidence": "$inputs.confidence",
      "class_filter": [
        "person",
        "cell phone"
      ]
    }
  ],
  "outputs": [
    {
      "type": "JsonField",
      "name": "predictions",
      "selector": "$steps.detector.predictions"
    }
  ]
}
