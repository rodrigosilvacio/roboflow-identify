{
  "version": "1.0",
  "inputs": [
    {
      "type": "WorkflowImage",
      "name": "image"
    },
    {
      "type": "WorkflowParameter",
      "name": "confidence",
      "default_value": 0.5
    },
    {
      "type": "WorkflowParameter",
      "name": "phone_confidence",
      "default_value": 0.3
    }
  ],
  "steps": [
    {
      "type": "roboflow_core/roboflow_object_detection_model@v2",
      "name": "people",
      "image": "$inputs.image",
      "model_id": "rfdetr-nano",
      "confidence": "$inputs.confidence",
      "class_filter": [
        "person"
      ]
    },
    {
      "type": "DetectionsTransformation",
      "name": "enlarge",
      "predictions": "$steps.people.predictions",
      "operations": [
        {
          "type": "DetectionsOffset",
          "offset_x": 80,
          "offset_y": 40
        }
      ]
    },
    {
      "type": "roboflow_core/dynamic_crop@v1",
      "name": "crop",
      "image": "$inputs.image",
      "predictions": "$steps.enlarge.predictions"
    },
    {
      "type": "roboflow_core/roboflow_object_detection_model@v2",
      "name": "phones_in_crop",
      "image": "$steps.crop.crops",
      "model_id": "rfdetr-small",
      "confidence": "$inputs.phone_confidence",
      "class_filter": [
        "cell phone"
      ]
    },
    {
      "type": "roboflow_core/detections_stitch@v1",
      "name": "phones_near_people",
      "reference_image": "$inputs.image",
      "predictions": "$steps.phones_in_crop.predictions",
      "overlap_filtering_strategy": "nms"
    },
    {
      "type": "roboflow_core/roboflow_object_detection_model@v2",
      "name": "phones_full_image",
      "image": "$inputs.image",
      "model_id": "rfdetr-small",
      "confidence": "$inputs.phone_confidence",
      "class_filter": [
        "cell phone"
      ]
    }
  ],
  "outputs": [
    {
      "type": "JsonField",
      "name": "people",
      "selector": "$steps.people.predictions"
    },
    {
      "type": "JsonField",
      "name": "phones_near_people",
      "selector": "$steps.phones_near_people.predictions"
    },
    {
      "type": "JsonField",
      "name": "phones_full_image",
      "selector": "$steps.phones_full_image.predictions"
    }
  ]
}
